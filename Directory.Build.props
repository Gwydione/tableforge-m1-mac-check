<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
    <AvaloniaWebViewVersion>12.1.0</AvaloniaWebViewVersion>
    <Version>0.1.0</Version>
    <!-- Avalonia.BuildServices sends anonymous build telemetry unless opted out. -->
    <AvaloniaTelemetryOptOut>true</AvaloniaTelemetryOptOut>
  </PropertyGroup>
  <ItemGroup Condition="'$(MacCheckBuildId)' != ''">
    <AssemblyMetadata Include="BuildId" Value="$(MacCheckBuildId)" />
  </ItemGroup>
</Project>
