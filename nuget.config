<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Experiment-local package cache: nothing is added to the user's global NuGet cache. -->
    <add key="globalPackagesFolder" value=".nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
